generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("student")
  createdAt    DateTime  @default(now()) @map("created_at")
  profile      Profile?
  problems     Problem[]

  @@map("users")
}

model Profile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String  @map("display_name")
  handle      String  @unique
  bio         String?
  language    String  @default("cpp")

  @@map("profiles")
}

model Problem {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  statement   String
  difficulty  Int
  createdById Int      @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  solutions   Solution[]
  testCases   TestCase[]
  submissions Submission[]

  @@map("problems")
}

model Solution {
  id          Int          @id @default(autoincrement())
  problemId   Int          @map("problem_id")
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name        String
  language    String
  code        String
  submissions Submission[]

  @@unique([problemId, id])
  @@map("solutions")
}

model TestCase {
  problemId  Int     @map("problem_id")
  caseNumber Int     @map("case_number")
  problem    Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  name       String
  input      String
  expected   String

  @@id([problemId, caseNumber])
  @@map("test_cases")
}

model Submission {
  id         Int       @id @default(autoincrement())
  problemId  Int       @map("problem_id")
  problem    Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  solutionId Int?      @map("solution_id")
  solution   Solution? @relation(fields: [problemId, solutionId], references: [problemId, id], onDelete: NoAction)
  verdict    String
  runtimeMs  Float?    @map("runtime_ms")
  memoryKiB  Int?      @map("memory_kib")
  request    Json
  result     Json
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([problemId, createdAt])
  @@index([problemId, solutionId])
  @@map("submissions")
}
