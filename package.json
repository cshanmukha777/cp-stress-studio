{
  "name": "cp-stress-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --strictPort\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "start": "electron .",
    "test:desktop": "npm run build && playwright test",
    "viva:member2": "node scripts/viva_demo.mjs",
    "dist:mac": "cross-env VITE_API_URL=http://127.0.0.1:4000 npm run build && node scripts/prepare-mac-backend.mjs && electron-builder --mac"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^7.10.1",
    "monaco-editor": "0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-split": "^2.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "prisma": "^8.0.0-rc.33",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.cshanmukha777.cpstressstudio",
    "productName": "CP Stress Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asarUnpack": [
      "server/node_modules/.prisma/**/*",
      "server/node_modules/@prisma/**/*",
      "server/src/generated/prisma/**/*",
      "electron/execution/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "backend/server",
        "filter": [
          "package.json",
          "src/**/*",
          "node_modules/**/*",
          "node_modules/.prisma/**/*",
          "!**/.env*"
        ]
      },
      {
        "from": "electron",
        "to": "backend/electron",
        "filter": [
          "package.json",
          "execution/**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
